# PREPARED ONLY. Not referenced by own675 startup. No up/run/start/create/pull.
# Merge only for static config checks with a base defining runtime-network.
services:
  supply-temporal-volume-init:
    profiles: [own675-supply-prepared]
    image: alpine:3.22
    network_mode: none
    restart: "no"
    command: [chown, "1000:1000", /data]
    volumes:
      - own675-supply-temporal:/data

  supply-temporal:
    profiles: [own675-supply-prepared]
    image: temporalio/temporal@sha256:cf86707827fac99e4d1c4a47dc11b105382d796199c7bd41fb3213fb0471628e
    network_mode: service:runtime-network
    command: [server, start-dev, --headless, --ip, 127.0.0.1, --db-filename, /data/temporal.db]
    volumes:
      - own675-supply-temporal:/data
    depends_on:
      supply-temporal-volume-init:
        condition: service_completed_successfully
      runtime-network:
        condition: service_started
    healthcheck:
      test: [CMD, temporal, operator, cluster, health]
      interval: 5s
      timeout: 5s
      retries: 30

volumes:
  own675-supply-temporal:
    name: "${COMPOSE_PROJECT_NAME:?Set the exact approved own675 project}-supply-temporal"
