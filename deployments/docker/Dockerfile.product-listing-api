# syntax=docker/dockerfile:1

ARG API_RUNTIME_BASE_IMAGE=docker.io/xuwei190/crawler-env:latest

FROM golang:1.26-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git make

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy only the necessary source files for compilation
COPY cmd/current-application/ cmd/current-application/
COPY cmd/product-agent-runtime-prepare/ cmd/product-agent-runtime-prepare/
COPY cmd/local-ai-trial-grant/ cmd/local-ai-trial-grant/
COPY cmd/image-agent-temporal-worker/ cmd/image-agent-temporal-worker/
COPY cmd/product-listing-api-schema-migrate/ cmd/product-listing-api-schema-migrate/
COPY cmd/listingkit-schema-migrate/ cmd/listingkit-schema-migrate/
COPY internal/ internal/
COPY config/ config/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/current-application ./cmd/current-application
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/product-agent-runtime-prepare ./cmd/product-agent-runtime-prepare
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/local-ai-trial-grant ./cmd/local-ai-trial-grant
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/image-agent-temporal-worker ./cmd/image-agent-temporal-worker
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/product-listing-api-schema-migrate ./cmd/product-listing-api-schema-migrate
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/listingkit-schema-migrate ./cmd/listingkit-schema-migrate

FROM ${API_RUNTIME_BASE_IMAGE}

LABEL org.opencontainers.image.current.application="private-manifest-v1"
LABEL org.opencontainers.image.listingkit.identity="canonical-subject-v1"
LABEL org.opencontainers.image.listingkit.image-agent-routing="image-agent-v3-new-starts-v1"

WORKDIR /app

COPY --from=builder /out/current-application /app/current-application
COPY --from=builder /out/product-agent-runtime-prepare /app/product-agent-runtime-prepare
COPY --from=builder /out/local-ai-trial-grant /app/local-ai-trial-grant
COPY --from=builder /out/image-agent-temporal-worker /app/image-agent-temporal-worker
COPY --from=builder /out/product-listing-api-schema-migrate /app/product-listing-api-schema-migrate
COPY --from=builder /out/listingkit-schema-migrate /app/listingkit-schema-migrate
COPY --from=builder /src/config /app/config

RUN mkdir -p /app/logs /app/tmp /app/chrome && \
    chmod +x /app/current-application /app/product-agent-runtime-prepare /app/local-ai-trial-grant /app/image-agent-temporal-worker /app/product-listing-api-schema-migrate /app/listingkit-schema-migrate

EXPOSE 8085

CMD ["/app/current-application"]
# Supply --config with the existing absolute private current-application manifest.
# This image cannot be deployed by the legacy ListingKit API rollout contract.
