# Copy OUTSIDE the checkout and replace every placeholder. Do not commit secrets.
# Used by the isolated Chatwoot services; app BFF settings are separate below.
FRONTEND_URL=http://localhost:36500
SECRET_KEY_BASE=REPLACE_WITH_64_OR_MORE_RANDOM_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DEFAULT_LOCALE=zh_CN
LOG_LEVEL=warn
ENABLE_ACCOUNT_SIGNUP=false
ENABLE_API_CORS=false
DIRECT_UPLOADS_ENABLED=false
# No live SMTP or paid channel/provider credentials by default.
MAILER_SENDER_EMAIL=Platform Support <support@example.invalid>
SMTP_ADDRESS=
