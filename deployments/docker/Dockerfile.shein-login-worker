FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git
WORKDIR /src

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd/shein-login-worker/ cmd/shein-login-worker/
COPY cmd/playwright-installer/ cmd/playwright-installer/
COPY cmd/fingerprint-browser-installer/ cmd/fingerprint-browser-installer/
COPY internal/ internal/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/shein-login-worker ./cmd/shein-login-worker
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/playwright-installer ./cmd/playwright-installer
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/fingerprint-browser-installer ./cmd/fingerprint-browser-installer

FROM docker.io/xuwei190/crawler-env:latest

WORKDIR /app
ENV TZ=Asia/Shanghai
ENV FINGERPRINT_CHROME_VERSION=144
ENV FINGERPRINT_CHROME_DIR=/app/chrome
ENV PLAYWRIGHT_DRIVER_PATH=/app/playwright-driver

COPY --from=builder /out/shein-login-worker /app/shein-login-worker
COPY --from=builder /out/playwright-installer /usr/local/bin/playwright-installer
COPY --from=builder /out/fingerprint-browser-installer /usr/local/bin/fingerprint-browser-installer

# Bake and verify Chrome in the Worker image so it never downloads a browser at
# login time or depends on an image-external /opt path.
RUN chmod +x /usr/local/bin/playwright-installer /usr/local/bin/fingerprint-browser-installer && \
    mkdir -p /app/logs /app/tmp /app/chrome && \
    /usr/local/bin/playwright-installer && \
    /usr/local/bin/fingerprint-browser-installer && \
    test -x /app/chrome/chrome-144/chrome && \
    chmod +x /app/shein-login-worker

EXPOSE 8086
ENTRYPOINT ["/app/shein-login-worker"]
CMD ["-config", "/run/shein-login-worker/current.json", "-log-level", "info", "-health-port", "8086"]
